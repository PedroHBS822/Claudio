<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        For a pure Compose app (ComponentActivity), use a plain platform theme.
        android:Theme.Black.NoTitleBar is available from API 1 on all devices.
    -->
    <style name="Theme.SkyTracker" parent="android:Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
